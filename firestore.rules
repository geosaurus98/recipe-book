rules_version = '2';

// Rules for the meal planner's shared households (paste into Firebase:
// Firestore Database > Rules). A household is only reachable by its
// 24-character code from the share link; nobody can list or delete them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{code} {
      allow get: if code.size() >= 20;
      allow create, update: if code.size() >= 20
        && request.resource.data.keys().hasOnly(['state', 'updated']);
    }
  }
}
